@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rpg: <http://example.org/rpg-ontology#> .

rpg:Actor a rdfs:Class .
# Subclasses of Actor. The triplestore does no RDFS reasoning, so every
# Organization/Deity is ALSO explicitly typed rpg:Actor - query rpg:Actor to
# get everything, or the subclass to narrow.
rpg:Organization rdfs:subClassOf rpg:Actor .
rpg:Deity rdfs:subClassOf rpg:Actor .
# A book/adventure an entity was extracted from.
rpg:SourceDocument a rdfs:Class .
# An adventure being written with the author agent. Its entities live in a
# separate named graph (urn:rpg:adventure:<slug>), flagged non-canon, and are
# sourced to this node via rpg:foundIn.
rpg:Adventure rdfs:subClassOf rpg:SourceDocument .
rpg:isCanon a rdf:Property ; rdfs:range xsd:boolean .
rpg:Item a rdfs:Class .
rpg:Location a rdfs:Class .
rpg:World rdfs:subClassOf rpg:Location .
# Place hierarchy, largest to smallest:
#   World > Region > Settlement (village/town/city) > Structure (castle, tower,
#   inn, shop, temple, farm, any single building or compound) > Room (a keyed
#   area/chamber inside a structure or dungeon).
# A Landmark is a named place that fits none of these (a road, ford, hill,
# grove). rpg:Location itself is the abstract parent and is never used as an
# entity's own type. The triplestore does no inference, so ingestion asserts
# the parent type explicitly: every place has its specific type AND rpg:Location.
# Find "every place" with   ?place a rpg:Location .   Narrow with e.g.
#   ?place a rpg:Structure .
rpg:Landmark rdfs:subClassOf rpg:Location .
rpg:Region rdfs:subClassOf rpg:Location .
rpg:Settlement rdfs:subClassOf rpg:Location .
rpg:Structure rdfs:subClassOf rpg:Location .
rpg:Room rdfs:subClassOf rpg:Location .
rpg:Event a rdfs:Class .
rpg:HistoricalEvent rdfs:subClassOf rpg:Event .
rpg:SessionEvent rdfs:subClassOf rpg:Event .
rpg:Scene rdfs:subClassOf rpg:Event .
rpg:HiddenInfo a rdfs:Class .
rpg:ReadAloudText a rdfs:Class .
rpg:Trigger a rdfs:Class .
rpg:GameSystem a rdfs:Class .
rpg:StatBlock a rdfs:Class .
# An unresolved narrative opportunity (rumor, bounty, patron request, faction
# goal) a GM can build a new adventure around - distinct from HistoricalEvent
# (already happened) and Trigger (a conditional bound to a written Scene).
rpg:PlotHook a rdfs:Class .

rpg:name a rdf:Property ; rdfs:range xsd:string .
rpg:isPlayerFacing a rdf:Property ; rdfs:range xsd:boolean .
# A hook is never resolved globally. A HookResolution lives in a chat session's
# own graph (urn:rpg:session:<id>) and marks the hook resolved for that session only.
rpg:HookResolution a rdfs:Class .
rpg:resolvesHook a rdf:Property ; rdfs:domain rpg:HookResolution ; rdfs:range rpg:PlotHook .
rpg:inSession a rdf:Property ; rdfs:domain rpg:HookResolution ; rdfs:range xsd:string .
rpg:resolvedAt a rdf:Property ; rdfs:domain rpg:HookResolution ; rdfs:range xsd:integer .
rpg:isResolved a rdf:Property ; rdfs:range xsd:boolean .
rpg:status a rdf:Property ; rdfs:range xsd:string .
rpg:outcome a rdf:Property ; rdfs:range xsd:string .
rpg:dcTarget a rdf:Property ; rdfs:range xsd:integer .
rpg:physicalAppearance a rdf:Property ; rdfs:range xsd:string .
rpg:gmDescription a rdf:Property ; rdfs:range xsd:string .
rpg:loreContext a rdf:Property ; rdfs:range xsd:string .
rpg:alias a rdf:Property ; rdfs:range xsd:string .

# Stat block mechanics, kept as strings rather than xsd:integer since values
# like "22 (4d8+4)" or "15 (chain mail)" don't parse cleanly as plain numbers.
rpg:armorClass a rdf:Property ; rdfs:domain rpg:StatBlock ; rdfs:range xsd:string .
rpg:hitPoints a rdf:Property ; rdfs:domain rpg:StatBlock ; rdfs:range xsd:string .
rpg:hitDice a rdf:Property ; rdfs:domain rpg:StatBlock ; rdfs:range xsd:string .
rpg:thac0 a rdf:Property ; rdfs:domain rpg:StatBlock ; rdfs:range xsd:string .
rpg:numAttacks a rdf:Property ; rdfs:domain rpg:StatBlock ; rdfs:range xsd:string .
rpg:damage a rdf:Property ; rdfs:domain rpg:StatBlock ; rdfs:range xsd:string .
rpg:movementRate a rdf:Property ; rdfs:domain rpg:StatBlock ; rdfs:range xsd:string .
rpg:savingThrow a rdf:Property ; rdfs:domain rpg:StatBlock ; rdfs:range xsd:string .
rpg:quality a rdf:Property ; rdfs:domain rpg:StatBlock ; rdfs:range xsd:string .
rpg:defenseRating a rdf:Property ; rdfs:domain rpg:StatBlock ; rdfs:range xsd:string .

# Anything with a position (Actor, Item, place, text) can be located in a place.
# Where a Deity has worshippers, shrines or a following. Deities are not
# "located" in a place, so use this instead of locatedIn for them.
rpg:worshippedIn a rdf:Property ; rdfs:domain rpg:Deity ; rdfs:range rpg:Location .
rpg:locatedIn a rdf:Property, owl:TransitiveProperty ; rdfs:range rpg:Location .
rpg:occurredAt a rdf:Property ; rdfs:domain rpg:Event ; rdfs:range rpg:Location .
rpg:participatedIn a rdf:Property ; rdfs:domain rpg:Actor ; rdfs:range rpg:Event .
rpg:usesStatBlock a rdf:Property ; rdfs:domain rpg:Actor ; rdfs:range rpg:StatBlock .
rpg:designedFor a rdf:Property ; rdfs:domain rpg:StatBlock ; rdfs:range rpg:GameSystem .
rpg:hostsScene a rdf:Property ; rdfs:domain rpg:Location ; rdfs:range rpg:Scene .
rpg:spawns a rdf:Property ; rdfs:domain rpg:Scene ; rdfs:range rpg:Actor .
rpg:contains a rdf:Property ; rdfs:domain rpg:Scene ; rdfs:range rpg:Item .
rpg:owns a rdf:Property ; rdfs:domain rpg:Actor ; rdfs:range rpg:Item .
rpg:containsText a rdf:Property ; rdfs:domain rpg:Scene ; rdfs:range rpg:ReadAloudText .
rpg:containsTrigger a rdf:Property ; rdfs:domain rpg:Scene ; rdfs:range rpg:Trigger .
rpg:containsEvent a rdf:Property ; rdfs:domain rpg:Scene ; rdfs:range rpg:Event .
rpg:reveals a rdf:Property ; rdfs:domain rpg:Trigger ; rdfs:range rpg:HiddenInfo .
rpg:caused a rdf:Property ; rdfs:domain rpg:Event ; rdfs:range rpg:Event .
rpg:dependsOn a rdf:Property ; rdfs:domain rpg:Event ; rdfs:range rpg:Event .

rpg:hookGiver a rdf:Property ; rdfs:domain rpg:PlotHook ; rdfs:range rpg:Actor .
rpg:involvesActor a rdf:Property ; rdfs:domain rpg:PlotHook ; rdfs:range rpg:Actor .
rpg:involvesLocation a rdf:Property ; rdfs:domain rpg:PlotHook ; rdfs:range rpg:Location .
rpg:involvesItem a rdf:Property ; rdfs:domain rpg:PlotHook ; rdfs:range rpg:Item .

# Actor kind: "npc" | "creature" (monster type) | "group" | "deity".
rpg:actorKind a rdf:Property ; rdfs:domain rpg:Actor ; rdfs:range xsd:string .
# An Actor belonging to / serving a group or deity (Organization or Deity).
rpg:memberOf a rdf:Property ; rdfs:domain rpg:Actor ; rdfs:range rpg:Actor .
# Item kind: magic_item | treasure | weapon | armor | tool | container | document | consumable | other.
rpg:itemType a rdf:Property ; rdfs:domain rpg:Item ; rdfs:range xsd:string .
# Two Locations joined by a door, stair, passage etc. Stored in both directions
# (the store does no inference, so ingestion writes the reverse edge too).
rpg:connectsTo a rdf:Property, owl:SymmetricProperty ; rdfs:domain rpg:Location ; rdfs:range rpg:Location .
# Provenance: where in which book an entity was found. May have several values
# (an entity is usually mentioned in more than one place).
rpg:foundIn a rdf:Property ; rdfs:range rpg:SourceDocument .
rpg:foundOnPage a rdf:Property ; rdfs:range xsd:integer .
rpg:foundInSection a rdf:Property ; rdfs:range xsd:string .
# Session / adventure memory bookkeeping (see session_memory.py).
rpg:recordedAt a rdf:Property ; rdfs:range xsd:integer .
rpg:sequence a rdf:Property ; rdfs:range xsd:integer .
rpg:promotedFromSession a rdf:Property ; rdfs:range xsd:string .
